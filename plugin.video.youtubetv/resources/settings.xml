<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
	<section id="plugin.video.youtubetv">
		<category id="diagnostics" label="30030">
			<group id="1">
				<setting id="probe_clients" type="boolean" label="30033" help="30034">
					<level>0</level>
					<default>false</default>
					<control type="toggle"/>
				</setting>
				<setting id="probe_sabr_check" type="action" label="30056" help="30057">
					<level>0</level>
					<data>RunPlugin(plugin://plugin.video.youtubetv/?action=probe_sabr)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
				</setting>
				<setting id="prefer_token" type="boolean" label="30058" help="30059">
					<level>0</level>
					<default>false</default>
					<control type="toggle"/>
				</setting>
				<setting id="dump_manifest" type="boolean" label="30031" help="30032">
					<level>0</level>
					<default>false</default>
					<control type="toggle"/>
				</setting>
			</group>
		</category>
		<category id="playback" label="30010">
			<group id="1">
				<setting id="resume" type="boolean" label="30035" help="30036">
					<level>0</level>
					<default>true</default>
					<control type="toggle"/>
				</setting>
				<setting id="report_progress" type="boolean" label="30039" help="30040">
					<level>0</level>
					<default>true</default>
					<control type="toggle"/>
				</setting>
				<setting id="js_runtime" type="path" label="30037" help="30038">
					<level>0</level>
					<default></default>
					<constraints>
						<allowempty>true</allowempty>
					</constraints>
					<control type="button" format="file">
						<heading>30037</heading>
					</control>
				</setting>
				<setting id="max_height" type="integer" label="30011" help="30012">
					<level>0</level>
					<default>0</default>
					<constraints>
						<options>
							<option label="30013">0</option>
							<option label="30014">1080</option>
							<option label="30015">720</option>
							<option label="30016">480</option>
						</options>
					</constraints>
					<control type="list" format="integer"/>
				</setting>
			</group>
		</category>
		<category id="advanced" label="30020">
			<group id="1">
				<setting id="client_version" type="string" label="30021" help="30022">
					<level>2</level>
					<default>1.20260825.04.00</default>
					<constraints><allowempty>false</allowempty></constraints>
					<control type="edit" format="string"/>
				</setting>
				<setting id="proxy_port" type="integer" label="30023" help="30024">
					<level>2</level>
					<default>57814</default>
					<constraints><minimum>1024</minimum><maximum>65535</maximum></constraints>
					<control type="edit" format="integer"/>
				</setting>
				<setting id="po_token" type="string" label="30026" help="30027">
					<level>2</level>
					<default></default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string"/>
				</setting>
				<setting id="visitor_id" type="string" label="30025">
					<level>3</level>
					<default></default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string"/>
				</setting>
			</group>
		</category>
		<category id="account" label="30052">
			<group id="1">
				<!-- Only for the experimental code sign-in. Your own Google API
				     project, the same pair plugin.video.youtube asks for; the
				     add-on ships none. -->
				<setting id="oauth_client_id" type="string" label="30053" help="30054">
					<level>1</level>
					<default></default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string"/>
				</setting>
				<setting id="oauth_client_secret" type="string" label="30055" help="30054">
					<level>1</level>
					<default></default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string">
						<hidden>true</hidden>
					</control>
				</setting>
			</group>
		</category>
		<category id="integration" label="30045">
			<group id="1">
				<setting id="iptv.install" type="action" label="30046">
					<level>0</level>
					<data>InstallAddon(service.iptv.manager)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
					<visible>!System.HasAddon(service.iptv.manager)</visible>
				</setting>
				<setting id="iptv.enabled" type="boolean" label="30047" help="30048">
					<level>0</level>
					<default>true</default>
					<control type="toggle"/>
					<visible>System.HasAddon(service.iptv.manager)</visible>
				</setting>
				<setting id="iptv.settings" type="action" label="30049">
					<level>0</level>
					<data>Addon.OpenSettings(service.iptv.manager)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
					<dependencies>
						<dependency type="enable" setting="iptv.enabled" operator="is">true</dependency>
					</dependencies>
					<visible>System.HasAddon(service.iptv.manager)</visible>
				</setting>
				<!-- IPTV Manager reads these two to know where to call. They are
				     not choices, so they are not shown; it merges port= into the
				     query it finds here, which is why ?action= survives. -->
				<setting id="iptv.channels_uri" type="string" label="30050">
					<level>0</level>
					<default>plugin://plugin.video.youtubetv/?action=iptv_channels</default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string"/>
					<visible>false</visible>
				</setting>
				<setting id="iptv.epg_uri" type="string" label="30051">
					<level>0</level>
					<default>plugin://plugin.video.youtubetv/?action=iptv_epg</default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string"/>
					<visible>false</visible>
				</setting>
			</group>
		</category>
	</section>
</settings>
