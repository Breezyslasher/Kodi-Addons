<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
	<section id="plugin.video.frndlytv">
		<category id="account" label="30010">
			<group id="1">
				<setting id="username" type="string" label="30011" help="30012">
					<level>0</level>
					<default></default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string"/>
				</setting>
				<setting id="password" type="string" label="30013" help="30014">
					<level>0</level>
					<default></default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string">
						<hidden>true</hidden>
					</control>
				</setting>
				<setting id="signin" type="action" label="30015" help="30016">
					<level>0</level>
					<data>RunPlugin(plugin://plugin.video.frndlytv/?action=signin)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
				</setting>
				<setting id="signout" type="action" label="30017" help="30018">
					<level>0</level>
					<data>RunPlugin(plugin://plugin.video.frndlytv/?action=signout)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
				</setting>
			</group>
		</category>
		<category id="listings" label="30030">
			<group id="1">
				<setting id="full_info" type="boolean" label="30031" help="30032">
					<level>0</level>
					<default>true</default>
					<control type="toggle"/>
				</setting>
				<setting id="info_limit" type="integer" label="30033" help="30034">
					<level>1</level>
					<default>40</default>
					<constraints><minimum>0</minimum><step>10</step><maximum>100</maximum></constraints>
					<control type="slider" format="integer"/>
					<dependencies>
						<dependency type="enable" setting="full_info" operator="is">true</dependency>
					</dependencies>
				</setting>
			</group>
		</category>
		<category id="integration" label="30020">
			<group id="1">
				<setting id="iptv.install" type="action" label="30021">
					<level>0</level>
					<data>InstallAddon(service.iptv.manager)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
					<visible>!System.HasAddon(service.iptv.manager)</visible>
				</setting>
				<setting id="iptv.enabled" type="boolean" label="30022" help="30023">
					<level>0</level>
					<default>true</default>
					<control type="toggle"/>
					<visible>System.HasAddon(service.iptv.manager)</visible>
				</setting>
				<setting id="iptv.settings" type="action" label="30024">
					<level>0</level>
					<data>Addon.OpenSettings(service.iptv.manager)</data>
					<control type="button" format="action">
						<close>true</close>
					</control>
					<dependencies>
						<dependency type="enable" setting="iptv.enabled" operator="is">true</dependency>
					</dependencies>
					<visible>System.HasAddon(service.iptv.manager)</visible>
				</setting>
				<!-- IPTV Manager reads these two to know where to call. They are
				     not choices, so they are not shown; it merges port= into the
				     query it finds here, which is why ?action= survives. -->
				<setting id="iptv.channels_uri" type="string" label="30025">
					<level>0</level>
					<default>plugin://plugin.video.frndlytv/?action=iptv_channels</default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string"/>
					<visible>false</visible>
				</setting>
				<setting id="iptv.epg_uri" type="string" label="30026">
					<level>0</level>
					<default>plugin://plugin.video.frndlytv/?action=iptv_epg</default>
					<constraints><allowempty>true</allowempty></constraints>
					<control type="edit" format="string"/>
					<visible>false</visible>
				</setting>
			</group>
		</category>
	</section>
</settings>
