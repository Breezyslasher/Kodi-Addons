+        LOG::Log(LOGINFO, "ytv-probe: Decrypt -> status %d, out=%u",
+                 static_cast<int>(ret),
+                 ret == cdm::Status::kSuccess ? m_decryptOut.GetDataSize() : 0);
+      }
+      // --- end instrumentation -------------------------------------------
+    }
 
