+        }
+        std::string ivHex;
+        for (int i = 0; i < 16; ++i)
+        {
+          char pair[3];
+          std::snprintf(pair, sizeof(pair), "%02x", cdmIn.iv[i]);
+          ivHex += pair;
+        }
+        std::string subs;
+        for (uint32_t i = 0; i < cdmIn.num_subsamples; ++i)
+        {
+          char one[48];
+          std::snprintf(one, sizeof(one), "%s%u/%u", i ? "," : "",
+                        cdmIn.subsamples[i].clear_bytes,
+                        cdmIn.subsamples[i].cipher_bytes);
+          subs += one;
+        }
+        LOG::Log(LOGINFO,
+                 "ytv-probe: pool %u in=%u subs=%u [%s] scheme=%d "
